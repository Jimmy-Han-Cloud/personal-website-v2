<button
  type="button"
  id="translate-btn"
  class="text-sm text-muted hover:text-ink transition-colors cursor-pointer"
  aria-label="Translate this page with Google Translate (opens in a new tab)"
>
  Translate
</button>

<script>
  const btn = document.getElementById('translate-btn');
  btn?.addEventListener('click', () => {
    const url = `https://translate.google.com/translate?sl=auto&tl=zh-CN&u=${encodeURIComponent(window.location.href)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
