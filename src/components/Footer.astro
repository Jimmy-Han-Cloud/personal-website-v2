---
import { SITE } from '../lib/site';
---

<footer class="border-t border-line mt-24">
  <div class="mx-auto max-w-5xl px-6 py-12">
    <p class="font-serif text-lg text-ink max-w-xl">
      Always glad to connect — reach out, or find me where I already am.
    </p>
    <div class="mt-6 flex flex-wrap gap-5 text-sm text-muted">
      <a href={`mailto:${SITE.email}`} class="hover:text-ink transition-colors">Email</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener" class="hover:text-ink transition-colors">LinkedIn ↗</a>
      <a href={SITE.github} target="_blank" rel="noopener" class="hover:text-ink transition-colors">GitHub ↗</a>
      <a href={SITE.resumeUrl} target="_blank" rel="noopener" class="hover:text-ink transition-colors">Resume ↗</a>
    </div>
    <p class="mt-10 text-xs text-muted">© {new Date().getFullYear()} {SITE.name}</p>
  </div>
</footer>
