---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE, JOURNEY } from '../lib/site';

const allWork = (await getCollection('work', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const featured = allWork.filter((p) => p.data.featured);
const more = allWork.filter((p) => !p.data.featured);
---

<Layout
  title="Home"
  description={SITE.tagline}
>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 fade-in-up">
    <h1 class="font-serif text-3xl sm:text-4xl text-ink max-w-2xl">
      {SITE.tagline}
    </h1>
    <p class="mt-4 text-muted max-w-xl">{SITE.identitySuffix}</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {SITE.domainTags.map((tag) => (
        <span class="text-xs uppercase tracking-wide text-muted border border-line rounded-full px-3 py-1">
          {tag}
        </span>
      ))}
    </div>
    <div class="mt-8 flex gap-4">
      <a
        href="/work/"
        class="inline-flex items-center rounded-full bg-ink text-paper px-5 py-2.5 text-sm hover:bg-accent transition-colors"
      >
        View Work
      </a>
      <a
        href={SITE.resumeUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-full border border-line px-5 py-2.5 text-sm text-ink hover:border-ink transition-colors"
      >
        Resume ↗
      </a>
    </div>
  </section>

  <!-- Career Journey -->
  <section class="mx-auto max-w-5xl px-6 py-10 fade-in-up" aria-label="Career journey">
    <ol class="flex flex-wrap items-center gap-3 text-sm text-muted">
      {JOURNEY.map((step, i) => (
        <li class="flex items-center gap-3">
          <span class={i === JOURNEY.length - 1 ? 'text-ink font-medium' : ''}>{step}</span>
          {i < JOURNEY.length - 1 && <span aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
  </section>

  <!-- Work -->
  <section class="mx-auto max-w-5xl px-6 py-12 fade-in-up" aria-labelledby="work-heading">
    <h2 id="work-heading" class="font-serif text-2xl text-ink mb-6">Work</h2>

    {featured.length > 0 && (
      <div class="grid sm:grid-cols-2 gap-6">
        {featured.map((project) => (
          <a
            href={`/work/${project.id}/`}
            class="group block border border-line rounded-lg p-6 hover:border-ink transition-colors"
            style={project.data.accentColor ? `border-top: 3px solid ${project.data.accentColor}` : ''}
          >
            <h3 class="font-serif text-lg text-ink group-hover:text-accent transition-colors">
              {project.data.title}
            </h3>
            <p class="mt-2 text-sm text-muted">{project.data.summary}</p>
            <p class="mt-3 text-xs text-muted">{project.data.role} · {project.data.year}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.data.domains.map((d) => (
                <span class="text-xs text-muted border border-line rounded-full px-2.5 py-0.5">{d}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    )}

    {more.length > 0 && (
      <details class="mt-8 group">
        <summary class="cursor-pointer text-sm text-ink hover:text-accent transition-colors list-none flex items-center gap-2">
          <span aria-hidden="true" class="transition-transform group-open:rotate-90">▸</span>
          More Work
        </summary>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {more.map((project) => (
            <li>
              <a
                href={`/work/${project.id}/`}
                class="flex items-center justify-between py-3 hover:text-accent transition-colors"
              >
                <span class="text-sm text-ink">{project.data.title}</span>
                <span class="text-xs text-muted">{project.data.year}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <!-- Notes entry -->
  <section class="mx-auto max-w-5xl px-6 py-12 fade-in-up">
    <a href="/notes/" class="font-serif text-xl text-ink hover:text-accent transition-colors">
      Notes & Articles →
    </a>
  </section>
</Layout>
