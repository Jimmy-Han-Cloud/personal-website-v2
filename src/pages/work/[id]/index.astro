---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allWork = await getCollection('work', ({ data }) => data.published);
  return allWork.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, domains, role, githubUrl, demoUrl } = project.data;
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <p class="text-xs text-muted">{year} · {domains.join(' · ')}</p>
    <h1 class="font-serif text-3xl text-ink mt-2">{title}</h1>
    <p class="mt-3 text-lg text-muted">{summary}</p>
    <p class="mt-2 text-sm text-muted">Role: {role}</p>

    <div class="mt-8 flex gap-4">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center rounded-full border border-line px-4 py-2 text-sm text-ink hover:border-ink transition-colors"
        >
          View GitHub Evidence ↗
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center rounded-full bg-ink text-paper px-4 py-2 text-sm hover:bg-accent transition-colors"
        >
          Try Live Demo ↗
        </a>
      )}
    </div>

    <div class="prose prose-neutral mt-12 max-w-none">
      <Content />
    </div>

    <a href="/work/" class="mt-16 inline-block text-sm text-muted hover:text-ink transition-colors">
      ← Back to Work
    </a>
  </article>
</Layout>
