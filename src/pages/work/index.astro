---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allWork = (await getCollection('work', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
const featured = allWork.filter((p) => p.data.featured);
const more = allWork.filter((p) => !p.data.featured);
---

<Layout title="Work" description="Selected and more work.">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12">
    <h1 class="font-serif text-3xl text-ink">Work</h1>

    <h2 class="font-serif text-xl text-ink mt-10 mb-6">Featured</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {featured.map((project) => (
        <a
          href={`/work/${project.id}/`}
          class="group block border border-line rounded-lg p-6 hover:border-ink transition-colors"
          style={project.data.accentColor ? `border-top: 3px solid ${project.data.accentColor}` : ''}
        >
          <h3 class="font-serif text-lg text-ink group-hover:text-accent transition-colors">
            {project.data.title}
          </h3>
          <p class="mt-2 text-sm text-muted">{project.data.summary}</p>
          <p class="mt-3 text-xs text-muted">{project.data.role} · {project.data.year}</p>
        </a>
      ))}
    </div>

    {more.length > 0 && (
      <>
        <h2 class="font-serif text-xl text-ink mt-12 mb-4">More Work</h2>
        <ul class="divide-y divide-line border-y border-line">
          {more.map((project) => (
            <li>
              <a
                href={`/work/${project.id}/`}
                class="flex items-center justify-between py-4 hover:text-accent transition-colors"
              >
                <span>
                  <span class="text-sm text-ink">{project.data.title}</span>
                  <span class="block text-xs text-muted mt-0.5">{project.data.summary}</span>
                </span>
                <span class="text-xs text-muted shrink-0 ml-4">{project.data.year}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
</Layout>
