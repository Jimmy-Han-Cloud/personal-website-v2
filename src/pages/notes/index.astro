---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allNotes = (await getCollection('notes', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Notes" description="Short notes and longer articles.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <h1 class="font-serif text-3xl text-ink">Notes</h1>

    {allNotes.length === 0 ? (
      <p class="mt-8 text-muted">Nothing published yet — check back soon.</p>
    ) : (
      <ul class="mt-8 divide-y divide-line border-y border-line">
        {allNotes.map((note) => (
          <li>
            <a
              href={`/notes/${note.id}/`}
              class="flex items-center justify-between py-4 hover:text-accent transition-colors"
            >
              <span>
                <span class="text-sm text-ink">{note.data.title}</span>
                <span class="block text-xs text-muted mt-0.5">{note.data.summary}</span>
              </span>
              <span class="text-xs text-muted shrink-0 ml-4">
                {note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
